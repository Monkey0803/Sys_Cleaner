+import Darwin
+import Foundation
+
+/// One fixed buffer per worker, reused across directories.
+final class DirectoryMetadataBuffer {
+    let bytes = UnsafeMutableRawBufferPointer.allocate(byteCount: 65_536, alignment: 8)
+    deinit { bytes.deallocate() }
+}
+
+/// Reads file stamps with directory entries; unsupported attributes use the
+/// existing per-path metadata lookup. Directories also use that lookup so mount
+/// points and firmlinks retain the same device-boundary behavior as lstat.
+final class DirectoryMetadataReader {
+    struct Entry {
+        let name: String
+        let stamp: FileStamp?
+    }
+
+    private static let common = UInt32(ATTR_CMN_NAME | ATTR_CMN_DEVID | ATTR_CMN_OBJTYPE |
+                                      ATTR_CMN_MODTIME | ATTR_CMN_CHGTIME | ATTR_CMN_FILEID)
+    private static let file = UInt32(ATTR_FILE_LINKCOUNT | ATTR_FILE_ALLOCSIZE | ATTR_FILE_DATALENGTH)
+    private var attributes: attrlist
+    private let buffer: DirectoryMetadataBuffer
+    private let descriptor: Int32
+    private var remaining = 0
+    private var offset = 0
+    private var finished = false
+
+    init?(directory: URL, buffer: DirectoryMetadataBuffer) {
+        let descriptor = directory.withUnsafeFileSystemRepresentation { path in
+            path.map { Darwin.open($0, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC) } ?? -1
+        }
+        guard descriptor >= 0 else { return nil }
+        self.descriptor = descriptor
+        self.buffer = buffer
+        var attributes = attrlist()
+        attributes.bitmapcount = UInt16(ATTR_BIT_MAP_COUNT)
+        attributes.commonattr = Self.common | UInt32(ATTR_CMN_RETURNED_ATTRS) | UInt32(ATTR_CMN_ERROR)
+        attributes.fileattr = Self.file
+        self.attributes = attributes
+        // Probe before yielding anything. Unsupported filesystems can safely
+        // fall back to Foundation without replaying already counted entries.
+        let count = getattrlistbulk(descriptor, &self.attributes, buffer.bytes.baseAddress,
+                                    buffer.bytes.count, UInt64(FSOPT_PACK_INVAL_ATTRS))
+        guard count >= 0 else {
+            // All stored properties are initialized, so deinit closes the fd.
+            return nil
+        }
+        remaining = Int(count)
+        finished = count == 0
+    }
+
+    deinit { Darwin.close(descriptor) }
+
+    func metadata(named name: String) -> (stamp: FileStamp, isDirectory: Bool)? {
+        FileSafety.metadata(named: name, in: descriptor)
+    }
+
+    func next() throws -> Entry? {
+        while true {
+            if remaining == 0 {
+                if finished { return nil }
+                let count = getattrlistbulk(descriptor, &attributes, buffer.bytes.baseAddress,
+                                            buffer.bytes.count, UInt64(FSOPT_PACK_INVAL_ATTRS))
+                guard count >= 0 else { throw POSIXError(POSIXErrorCode(rawValue: errno) ?? .EIO) }
+                remaining = Int(count)
+                offset = 0
+                if count == 0 { finished = true; return nil }
+            }
+            guard offset <= buffer.bytes.count - MemoryLayout<UInt32>.size else { throw POSIXError(.EIO) }
+            let length = Int(buffer.bytes.loadUnaligned(fromByteOffset: offset, as: UInt32.self))
+            guard length >= 4, length <= buffer.bytes.count - offset else { throw POSIXError(.EIO) }
+            let record = UnsafeRawBufferPointer(rebasing: buffer.bytes[offset..<(offset + length)])
+            let entry = try Self.decode(record)
+            offset += length
+            remaining -= 1
+            // Foundation enumeration excludes AppleDouble sidecars too.
+            if entry.name == "." || entry.name == ".." || entry.name.hasPrefix("._") { continue }
+            return entry
+        }
+    }
+
+    static func decode(_ record: UnsafeRawBufferPointer) throws -> Entry {
+        // getattrlist attributes are packed on four-byte boundaries, even for
+        // 64-bit values. FSOPT_PACK_INVAL_ATTRS fixes the layout; returned masks
+        // determine whether any placeholder value can be used.
+        var cursor = 4
+        func read<T>(_ type: T.Type) throws -> T {
+            guard cursor <= record.count, MemoryLayout<T>.size <= record.count - cursor else {
+                throw POSIXError(.EIO)
+            }
+            defer { cursor += MemoryLayout<T>.size }
+            return record.loadUnaligned(fromByteOffset: cursor, as: type)
+        }
+        let returned = try read(attribute_set_t.self)
+        let itemError = try read(UInt32.self)
+        let nameReferenceOffset = cursor
+        let nameReference = try read(attrreference_t.self)
+        let device = try read(dev_t.self)
+        let type = try read(UInt32.self)
+        let modified = try read(timespec.self)
+        let changed = try read(timespec.self)
+        let inode = try read(UInt64.self)
+        // File-only attributes are omitted for directories even with
+        // FSOPT_PACK_INVAL_ATTRS. Other vnode types use the lstat fallback.
+        let regular = type == UInt32(VREG.rawValue)
+        let links = regular ? try read(UInt32.self) : 0
+        let allocated = regular ? try read(Int64.self) : 0
+        let size = regular ? try read(Int64.self) : 0
+        let nameOffset = nameReferenceOffset + Int(nameReference.attr_dataoffset)
+        let nameLength = Int(nameReference.attr_length)
+        guard returned.commonattr & UInt32(ATTR_CMN_NAME) != 0,
+              nameOffset >= cursor, nameLength > 1, nameOffset <= record.count,
+              nameLength <= record.count - nameOffset,
+              record[nameOffset + nameLength - 1] == 0,
+              let name = String(bytes: record[nameOffset..<(nameOffset + nameLength - 1)], encoding: .utf8),
+              !name.contains("/"), !name.utf8.contains(0) else { throw POSIXError(.EIO) }
+        let complete = itemError == 0 && regular &&
+            returned.commonattr & common == common && returned.fileattr & file == file &&
+            device >= 0 && size >= 0 && allocated >= 0 && links > 0 &&
+            (0..<1_000_000_000).contains(modified.tv_nsec) &&
+            (0..<1_000_000_000).contains(changed.tv_nsec)
+        let stamp = complete ? FileStamp(device: UInt64(device), inode: inode, size: size,
+                                         modifiedSeconds: Int64(modified.tv_sec),
+                                         modifiedNanoseconds: Int64(modified.tv_nsec),
+                                         linkCount: UInt64(links), allocatedBytes: allocated,
+                                         changedSeconds: Int64(changed.tv_sec),
+                                         changedNanoseconds: Int64(changed.tv_nsec)) : nil
+        return Entry(name: name, stamp: stamp)
+    }
+}
