+import Darwin
+import Foundation
+import XCTest
+@testable import SysCleanerCore
+
+final class DirectoryMetadataReaderTests: XCTestCase {
+    private var root: URL!
+
+    override func setUpWithError() throws {
+        root = FileManager.default.temporaryDirectory
+            .appendingPathComponent("SysCleanerBulk-\(UUID().uuidString)", isDirectory: true)
+        try FileManager.default.createDirectory(at: root, withIntermediateDirectories: false)
+    }
+
+    override func tearDownWithError() throws {
+        try FileManager.default.removeItem(at: root)
+    }
+
+    func testBulkFileStampsMatchLstatIncludingSparseFilesAndResourceForks() throws {
+        let regular = root.appendingPathComponent("file % # 中文")
+        try Data(repeating: 7, count: 9000).write(to: regular)
+        try FileManager.default.linkItem(at: regular, to: root.appendingPathComponent("hardlink"))
+        let sparse = root.appendingPathComponent("sparse")
+        try Data().write(to: sparse)
+        let handle = try FileHandle(forWritingTo: sparse)
+        try handle.truncate(atOffset: 32 * 1_048_576)
+        try handle.close()
+        let forked = root.appendingPathComponent("forked")
+        try Data([1]).write(to: forked)
+        let fork = [UInt8](repeating: 8, count: 8192)
+        let status = fork.withUnsafeBytes {
+            setxattr(forked.path, "com.apple.ResourceFork", $0.baseAddress, $0.count, 0, 0)
+        }
+        XCTAssertEqual(status, 0)
+        let directory = root.appendingPathComponent("directory")
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: false)
+        try FileManager.default.createSymbolicLink(at: root.appendingPathComponent("symlink"), withDestinationURL: regular)
+
+        let reader = try XCTUnwrap(DirectoryMetadataReader(directory: root, buffer: DirectoryMetadataBuffer()))
+        var entries: [String: DirectoryMetadataReader.Entry] = [:]
+        while let entry = try reader.next() { entries[entry.name] = entry }
+        XCTAssertEqual(entries.count, 6)
+        for name in [regular.lastPathComponent, "hardlink", "sparse", "forked"] {
+            let stamp = try XCTUnwrap(entries[name]?.stamp, name)
+            XCTAssertEqual(stamp, FileSafety.stamp(at: root.appendingPathComponent(name)), name)
+        }
+        XCTAssertNil(entries["directory"]?.stamp)
+        XCTAssertNil(entries["symlink"]?.stamp)
+        XCTAssertEqual(reader.metadata(named: "directory")?.stamp, FileSafety.stamp(at: directory))
+        XCTAssertEqual(reader.metadata(named: "directory")?.isDirectory, true)
+        XCTAssertNil(reader.metadata(named: "symlink"))
+    }
+
+    func testScannedURLsPreserveEscapedAndUnicodeFileNames() throws {
+        let original = root.appendingPathComponent("file % # 中文")
+        let copy = root.appendingPathComponent("copy %23 文件")
+        try Data([1, 2, 3]).write(to: original)
+        try Data([1, 2, 3]).write(to: copy)
+        let report = FileScanner.scan(ScanRequest(category: .duplicates, root: root))
+        XCTAssertEqual(Set(report.entries.map(\.url.path)),
+                       Set([original, copy].map { $0.resolvingSymlinksInPath().path }))
+        XCTAssertEqual(Set(report.entries.compactMap(\.duplicateGroup)).count, 1)
+        for entry in report.entries { XCTAssertEqual(entry.stamp, FileSafety.stamp(at: entry.url)) }
+    }
+
+    func testDecoderRejectsTruncatedRecordsAndInvalidNameOffsets() throws {
+        try Data([1]).write(to: root.appendingPathComponent("file"))
+        let buffer = DirectoryMetadataBuffer()
+        let reader = try XCTUnwrap(DirectoryMetadataReader(directory: root, buffer: buffer))
+        let length = Int(buffer.bytes.loadUnaligned(as: UInt32.self))
+        var record = Array(buffer.bytes.prefix(length))
+        try withExtendedLifetime(reader) {
+            for end in 0..<length {
+                try record.withUnsafeBytes { bytes in
+                    let truncated = UnsafeRawBufferPointer(rebasing: bytes[..<end])
+                    // Padding at the end is not required by the decoder.
+                    if end < 104 { XCTAssertThrowsError(try DirectoryMetadataReader.decode(truncated)) }
+                }
+            }
+        }
+        try record.withUnsafeMutableBytes { bytes in
+            bytes.storeBytes(of: Int32.max, toByteOffset: 28, as: Int32.self)
+            XCTAssertThrowsError(try DirectoryMetadataReader.decode(UnsafeRawBufferPointer(bytes)))
+        }
+    }
+
+    func testMissingFileAttributesRequirePerPathFallback() throws {
+        try Data([1]).write(to: root.appendingPathComponent("file"))
+        let buffer = DirectoryMetadataBuffer()
+        let reader = try XCTUnwrap(DirectoryMetadataReader(directory: root, buffer: buffer))
+        withExtendedLifetime(reader) {
+            let length = Int(buffer.bytes.loadUnaligned(as: UInt32.self))
+            var record = Array(buffer.bytes.prefix(length))
+            record.withUnsafeMutableBytes { bytes in
+                bytes.storeBytes(of: UInt32(0), toByteOffset: 16, as: UInt32.self)
+                let entry = try? DirectoryMetadataReader.decode(UnsafeRawBufferPointer(bytes))
+                XCTAssertEqual(entry?.name, "file")
+                XCTAssertNil(entry?.stamp)
+            }
+        }
+    }
+}
